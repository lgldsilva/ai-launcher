# Pure-logic coverage gate (>=90%).
#
# There is no COVER_PKGS here on purpose: the boundary is expressed as a regex
# over cover-profile paths, so the pre-push hook can race-test ./... for
# correctness while measuring only the pure-logic packages. The same boundary is
# stated three times and the three must agree:
#
#   .ai-standards.env        COVERAGE_EXCLUDE (this file) -- pre-push hook
#   Makefile                 -coverpkg + the awk filter   -- make test-coverage, CI
#   sonar-project.properties sonar.coverage.exclusions    -- SonarCloud
#   .github/workflows/ci.yml duplicate -coverpkg           -- Sonar coverage job
#
# Measured: internal/config, internal/catalog, internal/launcher,
# internal/container, minus the PTY executor and the platform-specific
# replace_*.go files (live I/O, exercised by the smoke tests instead).
COVERAGE_MIN=90
COVERAGE_EXCLUDE='((^|/)cmd/|deploy/|internal/tui/|internal/installer/|internal/selfupdate/|internal/cmd/|test/|internal/launcher/executor|internal/launcher/replace_)'
