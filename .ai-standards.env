# Pure-logic coverage gate (≥90%), matching make test-coverage and Sonar.
# Leave COVER_PKGS empty so pre-push race-tests + covers ./..., then filters
# the profile with COVERAGE_EXCLUDE (regex on cover-profile paths).
COVERAGE_MIN=90
COVERAGE_EXCLUDE='(cmd/|deploy/|internal/tui/|internal/installer/|internal/selfupdate/|test/|internal/launcher/executor|internal/launcher/replace_)'
